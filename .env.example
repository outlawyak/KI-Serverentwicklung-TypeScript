# Copy to `.env` and fill in the values. Never commit `.env`.

# REST server (src/config/config.mts)
PORT=3000
# Local development certificate from mkcert (T2.1), not committed
TLS_KEY_PATH=certs/key.pem
TLS_CERT_PATH=certs/cert.pem
# Keycloak realm "games"; the server verifies tokens for this client
KEYCLOAK_ISSUER=http://localhost:8880/realms/games
KEYCLOAK_JWKS_URL=http://localhost:8880/realms/games/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=games-client

# PostgreSQL container (compose.yaml), also used by the server and drizzle-kit
POSTGRES_HOST=localhost
POSTGRES_USER=games
POSTGRES_PASSWORD=
POSTGRES_DB=games
POSTGRES_PORT=5433

# Keycloak container (compose.yaml), console at http://localhost:8880
KEYCLOAK_PORT=8880
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Used by games-realm.json on import (realm "games", client "games-client")
KC_CLIENT_SECRET=
# Password of user "game-admin" (client role "admin")
KC_ADMIN_USER_PASSWORD=
# Password of user "game-user" (no role)
KC_USER_PASSWORD=
