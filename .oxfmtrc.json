{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always",
    "endOfLine": "lf",
    "ignorePatterns": ["**/*.md"],
    "overrides": [
        {
            "files": ["**/*.yaml", "**/*.yml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
