meta {
  name: GET game by ID
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/rest/games/1000
  body: none
  auth: none
}

script:post-response {
  bru.setVar('etag1000', res.headers.etag);
}

tests {
  test('status 200', () => expect(res.status).to.equal(200));
  test('ETag is the version', () => expect(res.headers.etag).to.equal(`"${res.body.version}"`));
  test('1:1 details and 1:N reviews', () => {
    expect(res.body.details).to.be.an('object');
    expect(res.body.reviews).to.be.an('array').that.is.not.empty;
  });
}
