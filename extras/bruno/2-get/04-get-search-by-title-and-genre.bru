meta {
  name: GET search by title and genre
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/rest/games?title=e&genre=sim
  body: none
  auth: none
}

tests {
  test('status 200', () => expect(res.status).to.equal(200));
  test('Stardew Valley found', () => expect(res.body.map((game) => game.title)).to.eql(['Stardew Valley']));
}
