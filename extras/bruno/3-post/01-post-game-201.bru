meta {
  name: POST game 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/rest/games
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Bruno Test Game",
    "genre": "Puzzle",
    "releaseDate": "2024-05-01"
  }
}

script:post-response {
  bru.setVar('newGameUrl', res.headers.location);
}

tests {
  test('status 201', () => expect(res.status).to.equal(201));
  test('Location points to the new game', () => expect(res.headers.location).to.match(/\/rest\/games\/[1-9][0-9]*$/));
  test('no body', () => expect(res.body ?? '').to.equal(''));
}
