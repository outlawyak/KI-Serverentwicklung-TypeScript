meta {
  name: POST details for unknown game 404
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/rest/games/9999/details
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "developer": "Nobody"
  }
}

tests {
  test('status 404', () => expect(res.status).to.equal(404));
  test('Problem Details', () => {
    expect(res.headers['content-type']).to.include('application/problem+json');
    expect(res.body.status).to.equal(404);
  });
}
