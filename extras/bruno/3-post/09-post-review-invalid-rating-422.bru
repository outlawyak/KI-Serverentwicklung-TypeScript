meta {
  name: POST review invalid rating 422
  type: http
  seq: 9
}

post {
  url: {{newGameUrl}}/reviews
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rating": 6
  }
}

tests {
  test('status 422', () => expect(res.status).to.equal(422));
  test('Problem Details', () => {
    expect(res.headers['content-type']).to.include('application/problem+json');
    expect(res.body.status).to.equal(422);
  });
}
