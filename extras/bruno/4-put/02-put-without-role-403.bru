meta {
  name: PUT without role 403
  type: http
  seq: 2
}

put {
  url: {{newGameUrl}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  If-Match: "0"
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "title": "Bruno Test Game",
    "genre": "Puzzle Platformer",
    "releaseDate": "2024-05-01"
  }
}

tests {
  test('status 403', () => expect(res.status).to.equal(403));
  test('Problem Details', () => {
    expect(res.headers['content-type']).to.include('application/problem+json');
    expect(res.body.status).to.equal(403);
  });
}
