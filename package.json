{
    "name": "ai-server-typescript",
    "version": "1.0.0",
    "private": true,
    "description": "REST server prototype for games with Hono, Drizzle and Keycloak",
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env --watch src/main.mts",
        "start": "node --env-file-if-exists=.env src/main.mts",
        "lint": "oxlint",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "tsc": "tsc --noEmit",
        "db:studio": "drizzle-kit studio --config drizzle.config.mts",
        "setup:env": "node scripts/setup-env.mts",
        "token": "node --env-file-if-exists=.env scripts/token.mts"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.4",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tsconfig/node-ts": "^23.6.5",
        "@tsconfig/node26": "^26.0.2",
        "@tsconfig/strictest": "^2.0.9",
        "@types/node": "^26.6.10",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "typescript": "^7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.21.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=26.13.1"
    },
    "packageManager": "pnpm@12.21.0"
}
