{
    "name": "ai-server-typescript",
    "version": "1.0.0",
    "description": "REST server prototype for games with Hono, Drizzle and Keycloak",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.21.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=26.13.1"
    },
    "scripts": {
        "dev": "node --watch src/main.mts",
        "start": "node src/main.mts",
        "lint": "oxlint",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "tsc": "tsc --noEmit",
        "db:studio": "drizzle-kit studio --config drizzle.config.mts"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.4",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@tsconfig/node-ts": "^23.6.5",
        "@tsconfig/node26": "^26.0.2",
        "@tsconfig/strictest": "^2.0.9",
        "@types/node": "^26.6.10",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "typescript": "^7.0.2"
    }
}
